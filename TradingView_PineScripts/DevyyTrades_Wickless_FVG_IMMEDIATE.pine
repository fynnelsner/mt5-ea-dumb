bullArrowColor  = input.color(color.green, title="Bullish Color", group=grpArr)
bearArrowColor  = input.color(color.red, title="Bearish Color", group=grpArr)

// ============================================================================
// INPUTS  FVG
// ============================================================================
fvgGR     = "Fair Value Gaps (4H + Daily)"
fvgSH1    = input.bool(true, "Enable 4H FVGs", group = fvgGR)
fvgFill1  = input.string("Wick Sweep", "Fill Method", options = ["None", "Any Touch", "Midpoint Reached", "Wick Sweep", "Body Beyond"], group = fvgGR)
fvgCb1    = input.color(#00B8D9, "Bull Color", group = fvgGR)
fvgCs1    = input.color(#FF8B00, "Bear Color", group = fvgGR)
nfvgLB1   = input.string("Show", "Labels", options = ["Show", "Hide"], group = fvgGR)
maxBars1  = input.int(360, "Max Bars Back", minval = 1, step = 20, group = fvgGR)

fvgSH2    = input.bool(false, "Enable Daily FVGs", group = fvgGR)
fvgFill2  = input.string("Wick Sweep", "Fill Method", options = ["None", "Any Touch", "Midpoint Reached", "Wick Sweep", "Body Beyond"], group = fvgGR)
fvgCb2    = input.color(#6EE7B7, "Bull Color", group = fvgGR)
fvgCs2    = input.color(#FF6B6B, "Bear Color", group = fvgGR)
nfvgLB2   = input.string("Hide", "Labels", options = ["Show", "Hide"], group = fvgGR)
maxBars2  = input.int(360, "Max Bars Back", minval = 1, step = 20, group = fvgGR)

maxFvgKeep = input.int(5, "Max Active FVGs per direction", minval=1, maxval=20, group=fvgGR)
invalidateOnStructBreak = input.bool(true, "Invalidate FVGs on 15m BOS/ChoCh", group=fvgGR)

// ============================================================================
// INPUTS  WEBHOOK
// ============================================================================
grpWebhook = "Webhook Settings"
enableWebhooks = input.bool(false, title="Enable Webhooks", group=grpWebhook)
sendWicklessEvents = input.bool(true, title="Send Wickless Candle Events", group=grpWebhook)

// ============================================================================
// WEBHOOK BUILDER (No-Wick ONLY with FVGs + structure history + trend)
// ============================================================================
// CLEAN: No-Wick ONLY — no FVGs or structure baked in
buildWicklessWebhook(direction, entryAnchor, latestHigh, latestLow, trendDirection) =>
    '{"source":"wickless","event":"wickless_signal","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","bar_time":' + str.tostring(time) + ',"data":{"direction":"' + direction + '","trend_direction":"' + trendDirection + '","entry_anchor":' + jsonPrice(entryAnchor) + ',"candle_open":' + jsonPrice(open) + ',"candle_high":' + jsonPrice(high) + ',"candle_low":' + jsonPrice(low) + ',"candle_close":' + jsonPrice(close) + ',"latest_structure_high":' + jsonPrice(latestHigh) + ',"latest_structure_low":' + jsonPrice(latestLow) + '}}'

// ============================================================================
// GLOBAL STATE
// ============================================================================
bool isGoldChart   = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
bool isSilverChart = str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER")
int pipOffset      = isGoldChart ? 1000 : isSilverChart ? 400 : 50
string activeZoneTime = (isGoldChart or isSilverChart) and zoneTime == "1500-1900" ? "1500-2000" : zoneTime

// FVG global arrays
noColor = #00000000
var array<FVG> bullFvgArray1 = array.new<FVG>()
var array<FVG> bearFvgArray1 = array.new<FVG>()
var array<HTFBarOHLC> barArray1 = array.new<HTFBarOHLC>()
var HTFBar barOpen1 = HTFBar.new(open, bar_index)
var HTFBar barHigh1 = HTFBar.new(high, bar_index)
var HTFBar barLow1 = HTFBar.new(low, bar_index)
var HTFBar barClose1 = HTFBar.new(close, bar_index)
var HTFBarOHLC barHist1 = HTFBarOHLC.new(barOpen1, barHigh1, barLow1, barClose1)
var int bullBarIndexEnd1 = na
var int bullBarIndexEnd1_1 = na
var int bearBarIndexEnd1 = na
var int bearBarIndexEnd1_1 = na
var bool bullProcess1 = false
var bool bullCondition1 = false
var bool bearProcess1 = false
var bool bearCondition1 = false

var array<FVG> bullFvgArray2 = array.new<FVG>()
var array<FVG> bearFvgArray2 = array.new<FVG>()
var array<HTFBarOHLC> barArray2 = array.new<HTFBarOHLC>()
var HTFBar barOpen2 = HTFBar.new(open, bar_index)
var HTFBar barHigh2 = HTFBar.new(high, bar_index)
var HTFBar barLow2 = HTFBar.new(low, bar_index)
var HTFBar barClose2 = HTFBar.new(close, bar_index)
var HTFBarOHLC barHist2 = HTFBarOHLC.new(barOpen2, barHigh2, barLow2, barClose2)
var int bullBarIndexEnd2 = na
var int bullBarIndexEnd2_1 = na
var int bearBarIndexEnd2 = na
var int bearBarIndexEnd2_1 = na
var bool bullProcess2 = false
var bool bullCondition2 = false
var bool bearProcess2 = false
var bool bearCondition2 = false

// Structure history (last 5 BOS/ChoCh)
var array<string> structHistory = array.new<string>()
MAX_STRUCT_HISTORY = 5

// Swing point history (last 10 HH/HL/LH/LL)
var array<string> swingHistory = array.new<string>()
MAX_SWING_HISTORY = 10

// FVG entry collector
var array<string> fvgEntries = array.new<string>()
var array<string> invalidatedFvgJsons = array.new<string>()

buildInvalidatedFvgEntry(fvgObj, tf, invalidatedBy) =>
    string _mitPx = fvgObj.wasMitigated ? str.tostring(fvgObj.mitPrice) : "null"
    '{"slot":"' + fvgObj.slotId + '","tf":"' + tf + '","direction":"' + fvgObj.direction + '","zone_top":' + str.tostring(fvgObj.zoneTop) + ',"zone_bottom":' + str.tostring(fvgObj.zoneBottom) + ',"zone_mid":' + str.tostring(math.avg(fvgObj.zoneTop,fvgObj.zoneBottom)) + ',"state":"invalidated","invalidated_by":"' + invalidatedBy + '","mit_price":' + _mitPx + '}'

// STRUCTURE-BASED INVALIDATION - Bullish FVGs die when 15m close pushes below zone_bottom
// Bearish FVGs die when 15m close pushes above zone_top
invalidateFvgsOnBreak(fvgArray, isBullFvg, tfLabel, breakType) =>
    if invalidateOnStructBreak and fvgArray.size() > 0
        for i = fvgArray.size() - 1 to 0
            fvg = array.get(fvgArray, i)
            if not fvg.breakConfirmed
                bool broken = isBullFvg ? close < fvg.zoneBottom : close > fvg.zoneTop
                if broken
                    array.push(invalidatedFvgJsons, buildInvalidatedFvgEntry(fvg, tfLabel, breakType))
                    if array.size(invalidatedFvgJsons) > 100
                        array.shift(invalidatedFvgJsons)
                    fvg.breakConfirmed := true


// ============================================================================
// SESSION BACKGROUNDS
// ============================================================================
inZone = time(timeframe.period, activeZoneTime, zoneTz)
bgcolor(showZone and not na(inZone) ? zoneColor : na)
var float zHigh = 0.0, var int zMid = na, var label zLbl = na
if not na(inZone) and na(inZone[1])
    zHigh := high, zMid := time + math.round(getZoneDuration(activeZoneTime) / 2)
    if showZoneText
        zLbl := label.new(zMid, high, "NO TRADING ZONE", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=sessTextColor, style=label.style_none, size=getTextSize(sessTextSizeStr), textalign=text.align_center)
if not na(inZone)
    zHigh := math.max(zHigh, high)
    if showZoneText and not na(zLbl)
        label.set_xy(zLbl, zMid, zHigh + (getPipSize(goldPipMode, silverPipMode) * pipOffset))

inAsia = time(timeframe.period, "1800-0200", zoneTz)
bgcolor(showAsia and not na(inAsia) ? color.new(color.blue, 85) : na)
inLon = time(timeframe.period, "0300-0900", zoneTz)
bgcolor(showLon and not na(inLon) ? color.new(color.gray, 85) : na)
inNY = time(timeframe.period, "0800-1700", zoneTz)
bgcolor(showNY and not na(inNY) ? color.new(color.green, 85) : na)

var line fStartLine = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.both, width=2)
var line fEndLine   = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.both, width=2)
var label fZoneLbl  = label.new(na, na, "NO TRADING ZONE", xloc=xloc.bar_time, textcolor=sessTextColor, style=label.style_none, size=getTextSize(sessTextSizeStr), textalign=text.align_center)
var float _recentHigh = 0.0
_recentHigh := ta.highest(high, 20)

if barstate.islast and showZone
    color solidZoneColor = color.rgb(color.r(zoneColor), color.g(zoneColor), color.b(zoneColor), 15)
    string zt = str.substring(activeZoneTime, 0, 9)
    int sH = int(str.tonumber(str.substring(zt, 0, 2)))
    int sM = int(str.tonumber(str.substring(zt, 2, 4)))
    int eH = int(str.tonumber(str.substring(zt, 5, 7)))
    int eM = int(str.tonumber(str.substring(zt, 7, 9)))
    int tYear = year(time, zoneTz)
    int tMonth = month(time, zoneTz)
    int tDay = dayofmonth(time, zoneTz)
    int nextStart = timestamp(zoneTz, tYear, tMonth, tDay, sH, sM, 0)
    int nextEnd   = timestamp(zoneTz, tYear, tMonth, tDay, eH, eM, 0)
    if eH < sH
        nextEnd += 86400000
    if time >= nextEnd
        nextStart += 86400000
        nextEnd   += 86400000
    if dayofweek(nextStart, zoneTz) == 7
        nextStart += 86400000
        nextEnd += 86400000
    line.set_xy1(fStartLine, nextStart, close)
    line.set_xy2(fStartLine, nextStart, close + syminfo.mintick)
    line.set_color(fStartLine, solidZoneColor)
    line.set_xy1(fEndLine, nextEnd, close)
    line.set_xy2(fEndLine, nextEnd, close + syminfo.mintick)
    line.set_color(fEndLine, solidZoneColor)
    if showZoneText and na(inZone)
        int midTime = nextStart + math.round((nextEnd - nextStart) / 2)
        label.set_xy(fZoneLbl, midTime, _recentHigh + (getPipSize(goldPipMode, silverPipMode) * pipOffset))
        label.set_text(fZoneLbl, "NO TRADING ZONE")
    else
        label.set_text(fZoneLbl, "")
else if not showZone
    line.set_xy1(fStartLine, na, na)
    line.set_xy1(fEndLine, na, na)
    label.set_xy(fZoneLbl, na, na)

// ============================================================================
// EMS STRUCTURE LOGIC (draws on chart, NO WEBHOOKS here)
// ============================================================================
ph = ta.pivothigh(high, pivotLength, pivotLength)
pl = ta.pivotlow(low, pivotLength, pivotLength)

var int trend = 0
var float lastHigh = na, var float lastLow = na
var float activeTop = na, var int activeTopLoc = na
var float activeBtm = na, var int activeBtmLoc = na
var bool topBroken = true, var bool btmBroken = true

if not na(ph)
    is_hh = na(lastHigh) or ph > lastHigh
    string swingType = is_hh ? "HH" : "LH"
    if showStruct
        label.new(bar_index[pivotLength], ph, swingType, color=color.new(color.white, 100), textcolor=is_hh ? colorHH_HL : colorLH_LL, style=label.style_label_down, size=size.small)
    // Log swing point for structure snapshot
    array.unshift(swingHistory, buildSwingEntry(swingType, ph, bar_index[pivotLength]))
    if array.size(swingHistory) > MAX_SWING_HISTORY
        array.pop(swingHistory)
    // IMMEDIATE ALERT: swing point
    if shouldSendWebhook(enableWebhooks)
        alert(buildSwingEvent(swingType, ph, bar_index[pivotLength]), alert.freq_once_per_bar_close)
    lastHigh := ph
    float anchorPrice = anchorType == "Body" ? math.max(open[pivotLength], close[pivotLength]) : high[pivotLength]
    int anchorLoc = bar_index[pivotLength]
    if anchorType == "Body"
        for i = 0 to (pivotLength * 2)
            float checkBody = math.max(open[i], close[i])
            if checkBody > anchorPrice
                anchorPrice := checkBody
    activeTop := anchorPrice
    activeTopLoc := anchorLoc
    topBroken := false

if not na(pl)
    is_hl = na(lastLow) or pl > lastLow
    string swingType = is_hl ? "HL" : "LL"
    if showStruct
        label.new(bar_index[pivotLength], pl, swingType, color=color.new(color.white, 100), textcolor=is_hl ? colorHH_HL : colorLH_LL, style=label.style_label_up, size=size.small)
    // Log swing point for structure snapshot
    array.unshift(swingHistory, buildSwingEntry(swingType, pl, bar_index[pivotLength]))
    if array.size(swingHistory) > MAX_SWING_HISTORY
        array.pop(swingHistory)
    // IMMEDIATE ALERT: swing point
    if shouldSendWebhook(enableWebhooks)
        alert(buildSwingEvent(swingType, pl, bar_index[pivotLength]), alert.freq_once_per_bar_close)
    lastLow := pl
    float anchorPrice = anchorType == "Body" ? math.min(open[pivotLength], close[pivotLength]) : low[pivotLength]
    int anchorLoc = bar_index[pivotLength]
    if anchorType == "Body"
        for i = 0 to (pivotLength * 2)
            float checkBody = math.min(open[i], close[i])
            if checkBody < anchorPrice
                anchorPrice := checkBody
    activeBtm := anchorPrice
    activeBtmLoc := anchorLoc
    btmBroken := false

// ============================================================================
// STRUCTURE BREAKS  with FVG invalidation and history tracking
// NO WEBHOOKS sent here — BOS/ChoCh are only recorded for No-Wick payload
// ============================================================================
if not na(activeTop) and close > activeTop and not topBroken
    is_bos = trend == 1
    if showBosChoch
        line.new(activeTopLoc, activeTop, bar_index, activeTop, color=colorBullBreak, style=line.style_solid, width=1)
        label.new(int((activeTopLoc + bar_index) / 2), activeTop, is_bos ? "BOS" : "CHoCH", color=color.new(color.white, 100), textcolor=colorBullBreak, style=label.style_label_down, size=size.small)
    trend := 1
    topBroken := true
    // Record in structure history
    array.unshift(structHistory, buildStructEntry(1, is_bos ? "BOS" : "CHOCH", activeTop))
    if array.size(structHistory) > MAX_STRUCT_HISTORY
        array.pop(structHistory)
    // IMMEDIATE ALERT: BOS/ChoCh
    if shouldSendWebhook(enableWebhooks)
        alert(buildBosChochEvent(1, is_bos ? "BOS" : "CHOCH", activeTop), alert.freq_once_per_bar_close)
    // Invalidate bearish FVGs: bullish break pushes close above bearish FVG zone_top (ONLY on 15min)
    if invalidateOnStructBreak and timeframe.period == "15"
        string breakType = is_bos ? "bullish_BOS" : "bullish_ChoCH"
        invalidateFvgsOnBreak(bearFvgArray1, false, "HTF1", breakType)
        invalidateFvgsOnBreak(bearFvgArray2, false, "HTF2", breakType)

if not na(activeBtm) and close < activeBtm and not btmBroken
    is_bos = trend == -1
    if showBosChoch
        line.new(activeBtmLoc, activeBtm, bar_index, activeBtm, color=colorBearBreak, style=line.style_solid, width=1)
        label.new(int((activeBtmLoc + bar_index) / 2), activeBtm, is_bos ? "BOS" : "CHoCH", color=color.new(color.white, 100), textcolor=colorBearBreak, style=label.style_label_up, size=size.small)
    trend := -1
    btmBroken := true
    // Record in structure history
    array.unshift(structHistory, buildStructEntry(-1, is_bos ? "BOS" : "CHOCH", activeBtm))
    if array.size(structHistory) > MAX_STRUCT_HISTORY
        array.pop(structHistory)
    // IMMEDIATE ALERT: BOS/ChoCh
    if shouldSendWebhook(enableWebhooks)
        alert(buildBosChochEvent(-1, is_bos ? "BOS" : "CHOCH", activeBtm), alert.freq_once_per_bar_close)
    // Invalidate bullish FVGs: bearish break pushes close below bullish FVG zone_bottom (ONLY on 15min)
    if invalidateOnStructBreak and timeframe.period == "15"
        string breakType = is_bos ? "bearish_BOS" : "bearish_ChoCH"
        invalidateFvgsOnBreak(bullFvgArray1, true, "HTF1", breakType)
        invalidateFvgsOnBreak(bullFvgArray2, true, "HTF2", breakType)

// ============================================================================
// FVG DETECTION  SLOT 1 (4H)
// ============================================================================
string tf1 = htfTF("4 Hours")
bool fvgTf1 = tf1 == timeframe.period
if timeframe.change(tf1)
    bullProcess1 := false
    bearProcess1 := false
    if barArray1.size() > 2
        barArray1.pop()
    barArray1.unshift(barHist1)
    barOpen1  := HTFBar.new(open, bar_index)
    barHigh1  := HTFBar.new(high, bar_index)
    barLow1   := HTFBar.new(low, bar_index)
    barClose1 := HTFBar.new(close, bar_index)
    barHist1  := HTFBarOHLC.new(barOpen1, barHigh1, barLow1, barClose1)
    bullBarIndexEnd1_1 := bullBarIndexEnd1
    bullBarIndexEnd1  := bar_index
    bearBarIndexEnd1_1 := bearBarIndexEnd1
    bearBarIndexEnd1  := bar_index
else
    if high > barHigh1.price
        barHigh1.price := high
        barHigh1.index := bar_index
    if low < barLow1.price
        barLow1.price := low
        barLow1.index := bar_index
    barClose1.price := close
    barClose1.index := bar_index
    if barArray1.size() > 2
        if low < barArray1.get(1).high.price
            bullBarIndexEnd1 := bar_index
        if high > barArray1.get(1).low.price
            bearBarIndexEnd1 := bar_index

if barArray1.size() > 2 and barArray2.size() > 2
    bool bullG1 = barArray1.get(0).low.price > barArray1.get(1).high.price or barArray1.get(1).low.price > barArray2.get(2).high.price
    bullCondition1 := barArray1.get(0).low.price > barArray1.get(2).high.price and barArray1.get(1).close.price > barArray1.get(2).high.price and not bullG1
    bool bearG1 = barArray1.get(0).high.price < barArray1.get(1).low.price or barArray1.get(1).high.price < barArray1.get(2).low.price
    bearCondition1 := barArray1.get(0).high.price < barArray1.get(2).low.price and barArray1.get(1).close.price < barArray1.get(2).low.price and not bearG1

if bullCondition1 and not bullProcess1
    bullProcess1 := true
    float zoneTop01 = barArray1.get(0).low.price
    float zoneBtm01 = barArray1.get(2).high.price
    fvg01 = FVG.new(
        label.new(bar_index + 1, math.avg(zoneTop01, zoneBtm01), nfvgLB1 == "Show" ? (fvgTf1 ? "Chart(" + tf1 + ") FVG" : "HTF(" + tf1 + ") FVG") : "", xloc.bar_index, color=noColor, style=label.style_label_left, textcolor=fvgCb1, size=size.small,
         tooltip=(fvgTf1 ? "Chart(" + tf1 + ") Bullish FVG" : "HTF(" + tf1 + ") Bullish FVG") + "\n\nZone Top " + str.format("{0, number, #,###.##}", zoneTop01) + "\nZone Mid " + str.format("{0, number, #,###.##}", math.avg(zoneTop01, zoneBtm01)) + "\nZone Btm " + str.format("{0, number, #,###.##}", zoneBtm01)),
        line.new(barArray1.get(0).low.index, zoneTop01, bar_index + 1, zoneTop01, color=color.new(fvgCb1, 65)),
        line.new(math.ceil(math.avg(barArray1.get(0).low.index, barArray1.get(2).high.index)), math.avg(zoneTop01, zoneBtm01), bar_index + 1, math.avg(zoneTop01, zoneBtm01), style=line.style_dotted, color=color.new(fvgCb1, 25)),
        line.new(barArray1.get(2).high.index, zoneBtm01, bar_index + 1, zoneBtm01, color=color.new(fvgCb1, 50), width=2),
        fvgFill1 == "Midpoint Reached" ? math.avg(zoneTop01, zoneBtm01) : fvgFill1 == "Any Touch" ? zoneTop01 : zoneBtm01,
        0,
        fvgTf1 ? "Chart(" + tf1 + ") FVG" : "HTF(" + tf1 + ") FVG",
        zoneTop01, zoneBtm01, "bullish", "HTF1", 0, 0.0, false, bar_index,
        false, false, na
     )
    bullFvgArray1.unshift(fvg01)
    first1 = bullFvgArray1.first()
    linefill.new(first1.lnTop, first1.lnBtm, color.new(fvgCb1, 89))
    trimFvgArray(bullFvgArray1, maxFvgKeep)

if bearCondition1 and not bearProcess1
    bearProcess1 := true
    float zoneTop02 = barArray1.get(2).low.price
    float zoneBtm02 = barArray1.get(0).high.price
    fvg02 = FVG.new(
        label.new(bar_index + 1, math.avg(zoneTop02, zoneBtm02), nfvgLB1 == "Show" ? (fvgTf1 ? "Chart(" + tf1 + ") FVG" : "HTF(" + tf1 + ") FVG") : "", xloc.bar_index, color=noColor, style=label.style_label_left, textcolor=fvgCs1, size=size.small,
         tooltip=(fvgTf1 ? "Chart(" + tf1 + ") Bearish FVG" : "HTF(" + tf1 + ") Bearish FVG") + "\n\nZone Top " + str.format("{0, number, #,###.##}", zoneTop02) + "\nZone Mid " + str.format("{0, number, #,###.##}", math.avg(zoneTop02, zoneBtm02)) + "\nZone Btm " + str.format("{0, number, #,###.##}", zoneBtm02)),
        line.new(barArray2.get(2).low.index, zoneTop02, bar_index + 1, zoneTop02, color=color.new(fvgCs1, 50), width=2),
        line.new(math.ceil(math.avg(barArray2.get(2).low.index, barArray2.get(0).high.index)), math.avg(zoneTop02, zoneBtm02), bar_index + 1, math.avg(zoneTop02, zoneBtm02), style=line.style_dotted, color=color.new(fvgCs1, 25)),
        line.new(barArray2.get(0).high.index, zoneBtm02, bar_index + 1, zoneBtm02, color=color.new(fvgCs1, 65)),
        fvgFill1 == "Midpoint Reached" ? math.avg(zoneTop02, zoneBtm02) : fvgFill1 == "Any Touch" ? zoneBtm02 : zoneTop02,
        0,
        fvgTf1 ? "Chart(" + tf1 + ") FVG" : "HTF(" + tf1 + ") FVG",
        zoneTop02, zoneBtm02, "bearish", "HTF1", 0, 0.0, false, bar_index,
        false, false, na
     )
    bearFvgArray1.unshift(fvg02)
    first1b = bearFvgArray1.first()
    linefill.new(first1b.lnTop, first1b.lnBtm, color.new(fvgCs1, 89))
    trimFvgArray(bearFvgArray1, maxFvgKeep)

updateFvg(bullFvgArray1, fvgFill1, "bull", nfvgLB1, "HTF1", tf1)
updateFvg(bearFvgArray1, fvgFill1, "bear", nfvgLB1, "HTF1", tf1)

// ============================================================================
// FVG DETECTION  SLOT 2 (Daily)
// ============================================================================
string tf2 = htfTF("1 Day")
bool fvgTf2 = tf2 == timeframe.period
if timeframe.change(tf2)
    bullProcess2 := false
    bearProcess2 := false
    if barArray2.size() > 2
        barArray2.pop()
    barArray2.unshift(barHist2)
    barOpen2  := HTFBar.new(open, bar_index)
    barHigh2  := HTFBar.new(high, bar_index)
    barLow2   := HTFBar.new(low, bar_index)
    barClose2 := HTFBar.new(close, bar_index)
    barHist2  := HTFBarOHLC.new(barOpen2, barHigh2, barLow2, barClose2)
    bullBarIndexEnd2_1 := bullBarIndexEnd2
    bullBarIndexEnd2  := bar_index
    bearBarIndexEnd2_1 := bearBarIndexEnd2
    bearBarIndexEnd2  := bar_index
else
    if high > barHigh2.price
        barHigh2.price := high
        barHigh2.index := bar_index
    if low < barLow2.price
        barLow2.price := low
        barLow2.index := bar_index
    barClose2.price := close
    barClose2.index := bar_index
    if barArray2.size() > 2
        if low < barArray2.get(1).high.price
            bullBarIndexEnd2 := bar_index
        if high > barArray2.get(1).low.price
            bearBarIndexEnd2 := bar_index

if barArray2.size() > 2
    bool bullG2 = barArray2.get(0).low.price > barArray2.get(1).high.price or barArray2.get(1).low.price > barArray2.get(2).high.price
    bullCondition2 := barArray2.get(0).low.price > barArray2.get(2).high.price and barArray2.get(1).close.price > barArray2.get(2).high.price and not bullG2
    bool bearG2 = barArray2.get(0).high.price < barArray2.get(1).low.price or barArray2.get(1).high.price < barArray2.get(2).low.price
    bearCondition2 := barArray2.get(0).high.price < barArray2.get(2).low.price and barArray2.get(1).close.price < barArray2.get(2).low.price and not bearG2

if bullCondition2 and not bullProcess2
    bullProcess2 := true
    float zoneTop11 = barArray2.get(0).low.price
    float zoneBtm11 = barArray2.get(2).high.price
    fvg11 = FVG.new(
        label.new(bar_index + 1, math.avg(zoneTop11, zoneBtm11), nfvgLB2 == "Show" ? (fvgTf2 ? "Chart(" + tf2 + ") FVG" : "HTF(" + tf2 + ") FVG") : "", xloc.bar_index, color=noColor, style=label.style_label_left, textcolor=fvgCb2, size=size.small,
         tooltip=(fvgTf2 ? "Chart(" + tf2 + ") Bullish FVG" : "HTF(" + tf2 + ") Bullish FVG") + "\n\nZone Top " + str.format("{0, number, #,###.##}", zoneTop11) + "\nZone Mid " + str.format("{0, number, #,###.##}", math.avg(zoneTop11, zoneBtm11)) + "\nZone Btm " + str.format("{0, number, #,###.##}", zoneBtm11)),
        line.new(barArray2.get(0).low.index, zoneTop11, bar_index + 1, zoneTop11, color=color.new(fvgCb2, 65)),
        line.new(math.ceil(math.avg(barArray2.get(0).low.index, barArray2.get(2).high.index)), math.avg(zoneTop11, zoneBtm11), bar_index + 1, math.avg(zoneTop11, zoneBtm11), style=line.style_dotted, color=color.new(fvgCb2, 25)),
        line.new(barArray2.get(2).high.index, zoneBtm11, bar_index + 1, zoneBtm11, color=color.new(fvgCb2, 50), width=2),
        fvgFill2 == "Midpoint Reached" ? math.avg(zoneTop11, zoneBtm11) : fvgFill2 == "Any Touch" ? zoneTop11 : zoneBtm11,
        0,
        fvgTf2 ? "Chart(" + tf2 + ") FVG" : "HTF(" + tf2 + ") FVG",
        zoneTop11, zoneBtm11, "bullish", "HTF2", 0, 0.0, false, bar_index,
        false, false, na
     )
    bullFvgArray2.unshift(fvg11)
    first2 = bullFvgArray2.first()
    linefill.new(first2.lnTop, first2.lnBtm, color.new(fvgCb2, 89))
    trimFvgArray(bullFvgArray2, maxFvgKeep)

if bearCondition2 and not bearProcess2
    bearProcess2 := true
    float zoneTop12 = barArray2.get(2).low.price
    float zoneBtm12 = barArray2.get(0).high.price
    fvg12 = FVG.new(
        label.new(bar_index + 1, math.avg(zoneTop12, zoneBtm12), nfvgLB2 == "Show" ? (fvgTf2 ? "Chart(" + tf2 + ") FVG" : "HTF(" + tf2 + ") FVG") : "", xloc.bar_index, color=noColor, style=label.style_label_left, textcolor=fvgCs2, size=size.small,
         tooltip=(fvgTf2 ? "Chart(" + tf2 + ") Bearish FVG" : "HTF(" + tf2 + ") Bearish FVG") + "\n\nZone Top " + str.format("{0, number, #,###.##}", zoneTop12) + "\nZone Mid " + str.format("{0, number, #,###.##}", math.avg(zoneTop12, zoneBtm12)) + "\nZone Btm " + str.format("{0, number, #,###.##}", zoneBtm12)),
        line.new(barArray2.get(2).low.index, zoneTop12, bar_index + 1, zoneTop12, color=color.new(fvgCs2, 50), width=2),
        line.new(math.ceil(math.avg(barArray2.get(2).low.index, barArray2.get(0).high.index)), math.avg(zoneTop12, zoneBtm12), bar_index + 1, math.avg(zoneTop12, zoneBtm12), style=line.style_dotted, color=color.new(fvgCs2, 25)),
        line.new(barArray2.get(0).high.index, zoneBtm12, bar_index + 1, zoneBtm12, color=color.new(fvgCs2, 65)),
        fvgFill2 == "Midpoint Reached" ? math.avg(zoneTop12, zoneBtm12) : fvgFill2 == "Any Touch" ? zoneBtm12 : zoneTop12,
        0,
        fvgTf2 ? "Chart(" + tf2 + ") FVG" : "HTF(" + tf2 + ") FVG",
        zoneTop12, zoneBtm12, "bearish", "HTF2", 0, 0.0, false, bar_index,
        false, false, na
     )
    bearFvgArray2.unshift(fvg12)
    first2b = bearFvgArray2.first()
    linefill.new(first2b.lnTop, first2b.lnBtm, color.new(fvgCs2, 89))
    trimFvgArray(bearFvgArray2, maxFvgKeep)

updateFvg(bullFvgArray2, fvgFill2, "bull", nfvgLB2, "HTF2", tf2)
updateFvg(bearFvgArray2, fvgFill2, "bear", nfvgLB2, "HTF2", tf2)

// ============================================================================
// NO-WICK OPEN ARROWS — clean, independent No-Wick signals
// ============================================================================
bullishNoWick = (close > open) and (open == low)
bearishNoWick = (close < open) and (open == high)

plotshape(showNoWick and bullishNoWick and arrowSizeStr == "Small", style=shape.triangleup, location=location.belowbar, color=bullArrowColor, size=size.small)
plotshape(showNoWick and bearishNoWick and arrowSizeStr == "Small", style=shape.triangledown, location=location.abovebar, color=bearArrowColor, size=size.small)
plotshape(showNoWick and bullishNoWick and arrowSizeStr == "Normal", style=shape.triangleup, location=location.belowbar, color=bullArrowColor, size=size.normal)
plotshape(showNoWick and bearishNoWick and arrowSizeStr == "Normal", style=shape.triangledown, location=location.abovebar, color=bearArrowColor, size=size.normal)

alertcondition(bullishNoWick, title="Bullish No-Wick Arrow", message="Bullish No-Wick Open detected")
alertcondition(bearishNoWick, title="Bearish No-Wick Arrow", message="Bearish No-Wick Open detected")

// Helper: convert internal trend int to string for webhook
string currentTrendStr = trend == 1 ? "bullish" : trend == -1 ? "bearish" : "neutral"

// --- Bullish No-Wick: CLEAN alert (No-Wick ONLY) ---
if bullishNoWick and shouldSendWebhook(enableWebhooks) and sendWicklessEvents
    alert(buildWicklessWebhook("bullish", low, lastHigh, lastLow, currentTrendStr), alert.freq_once_per_bar_close)

// --- Bearish No-Wick: CLEAN alert (No-Wick ONLY) ---
if bearishNoWick and shouldSendWebhook(enableWebhooks) and sendWicklessEvents
    alert(buildWicklessWebhook("bearish", high, lastHigh, lastLow, currentTrendStr), alert.freq_once_per_bar_close)


// ============================================================================
// PERIODIC STRUCTURE SNAPSHOT (every 15 minutes)
// Sends last 5 BOS/ChoCh events independently — NOT baked into No-Wick
// ============================================================================
var int lastStructSnapshotTimeMs = na
bool shouldSendStructSnapshot = shouldSendWebhook(enableWebhooks) and barstate.isconfirmed
bool structSnapshotReady = shouldSendStructSnapshot and (na(lastStructSnapshotTimeMs) or (time - lastStructSnapshotTimeMs) >= 900000)

buildStructureSnapshotJson() =>
    string structSnapJson = buildStructHistoryJson(structHistory)
    string swingSnapJson = buildSwingHistoryJson(swingHistory)
    string _lastHigh = na(lastHigh) ? "null" : jsonPrice(lastHigh)
    string _lastLow = na(lastLow) ? "null" : jsonPrice(lastLow)
    '{"source":"structure","event":"structure_snapshot","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","bar_time":' + str.tostring(time) + ',"latest_structure_high":' + _lastHigh + ',"latest_structure_low":' + _lastLow + ',"recent_structure":' + structSnapJson + ',"swing_points":' + swingSnapJson + '}'

alertcondition(structSnapshotReady, title="Structure Snapshot (15min)", message="structure_snapshot")

if shouldSendStructSnapshot and structSnapshotReady
    lastStructSnapshotTimeMs := time
    alert(buildStructureSnapshotJson(), alert.freq_once_per_bar_close)

// ============================================================================
// PERIODIC FVG STATE SNAPSHOT (every 15 minutes real-time)
// Sends ALL active FVGs to server cache regardless of No-Wick
// EA polls this via GET /api/fvg-periodic-updates
// ============================================================================
var string lastFvgSnapshotChecksum = ""
var int lastSnapshotTimeMs = na
if shouldSendWebhook(enableWebhooks) and barstate.isconfirmed
    int currentTimeMs = time
    if na(lastSnapshotTimeMs) or currentTimeMs - lastSnapshotTimeMs >= 900000  // 15 minutes in milliseconds
        array.clear(fvgEntries)
        collectFvgEntries(bullFvgArray1, tf1, fvgEntries)
        collectFvgEntries(bearFvgArray1, tf1, fvgEntries)
        collectFvgEntries(bullFvgArray2, tf2, fvgEntries)
        collectFvgEntries(bearFvgArray2, tf2, fvgEntries)
        // Append any invalidated FVGs since last webhook
        int invCount = array.size(invalidatedFvgJsons)
        if invCount > 0
            for i = 0 to invCount - 1
                array.push(fvgEntries, array.get(invalidatedFvgJsons, i))
        string fvgSnapJson = buildFvgJson(fvgEntries)
        // Always send every 15 minutes regardless of changes
        alert('{"source":"fvg","event":"fvg_snapshot","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","bar_time":' + str.tostring(time) + ',"count":' + str.tostring(array.size(fvgEntries)) + ',"active_count":' + str.tostring(array.size(fvgEntries) - invCount) + ',"invalidated_count":' + str.tostring(invCount) + ',"fvgs":' + fvgSnapJson + '}', alert.freq_once_per_bar_close)
        lastFvgSnapshotChecksum := fvgSnapJson
        lastSnapshotTimeMs := currentTimeMs
        // Only clear invalidated tracker when snapshot fires (guaranteed delivery)
        if invCount > 0
            array.clear(invalidatedFvgJsons)

// ============================================================================
// RISK DASHBOARD
// ============================================================================
var table riskTable = table.new(position.top_right, 2, 3, bgcolor=color.new(#1e222d, 0), border_color=color.new(#787b86, 0), border_width=1, frame_color=color.new(#787b86, 0), frame_width=1)

if showRiskDash and barstate.islast
    string lblSize = size.small
    string valSize = size.normal
    float actualRiskAmount = (accountBal * riskPercent / 100)
    float contractSize = 1
    if syminfo.type == "forex"
        contractSize := 100000
    else if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
        contractSize := 100
    else if str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER")
        contractSize := 5000
    float pipValueInQuote = contractSize * getPipSize(goldPipMode, silverPipMode)
    float exchangeRate = 1.0
    if accountCurr != syminfo.currency
        string crossTicker = "FX_IDC:" + accountCurr + syminfo.currency
        float crossRate = request.security(crossTicker, timeframe.period, close, ignore_invalid_symbol=true)
        if not na(crossRate)
            exchangeRate := crossRate
        else
            float fallbackRate = request.security(accountCurr + syminfo.currency, timeframe.period, close, ignore_invalid_symbol=true)
            if not na(fallbackRate)
                exchangeRate := fallbackRate
            else if str.startswith(syminfo.ticker, accountCurr) and str.endswith(syminfo.ticker, syminfo.currency)
                exchangeRate := close
    float currentPipValue = pipValueInQuote / exchangeRate
    lotSize = actualRiskAmount / (slPips * currentPipValue)
    string riskDisplayStr = str.tostring(riskPercent) + "% (" + str.tostring(actualRiskAmount, "#.##") + " " + accountCurr + ")"
    table.cell(riskTable, 0, 0, "Risk (%)", text_color=color.white, text_size=lblSize, bgcolor=color.new(#1e222d, 0))
    table.cell(riskTable, 1, 0, riskDisplayStr, text_color=color.white, text_size=lblSize, bgcolor=color.new(#1e222d, 0))
    table.cell(riskTable, 0, 1, "Stop Loss (Pips)", text_color=color.white, text_size=lblSize, bgcolor=color.new(#1e222d, 0))
    table.cell(riskTable, 1, 1, str.tostring(slPips), text_color=color.white, text_size=lblSize, bgcolor=color.new(#1e222d, 0))
    table.cell(riskTable, 0, 2, "Lot Size", text_color=color.yellow, text_size=valSize, text_halign=text.align_center, bgcolor=color.new(#1e222d, 0))
    table.cell(riskTable, 1, 2, str.tostring(lotSize, "#.##"), text_color=color.yellow, text_size=valSize, text_halign=text.align_center, bgcolor=color.new(#1e222d, 0))
else if not showRiskDash and barstate.islast
    table.clear(riskTable, 0, 0, 1, 2)

// ============================================================================
// MANUAL BACKTEST DASHBOARD
// ============================================================================
string btPos = showRiskDash ? position.bottom_right : position.top_right
var table btTable = table.new(btPos, 2, 5, border_width = 1, border_color = color.new(#787b86, 50), frame_color=color.new(#787b86, 50), frame_width=1)

if showBacktest and barstate.islast
    string btTextSize = size.normal
    int totalTrades = btWins + btLosses
    float winRate = totalTrades > 0 ? (btWins / totalTrades) * 100 : 0
    color bgColor   = color.new(#1e222d, 0)
    color textColor = color.white
    table.cell(btTable, 0, 0, "Metric", bgcolor=color.new(#2962ff, 40), text_color=textColor, text_halign=text.align_left, text_size=btTextSize)
    table.cell(btTable, 1, 0, "Value",  bgcolor=color.new(#2962ff, 40), text_color=textColor, text_halign=text.align_center, text_size=btTextSize)
    table.cell(btTable, 0, 1, "Total Trades", bgcolor=bgColor, text_color=textColor, text_halign=text.align_left, text_size=btTextSize)
    table.cell(btTable, 1, 1, str.tostring(totalTrades), bgcolor=bgColor, text_color=textColor, text_halign=text.align_center, text_size=btTextSize)
    table.cell(btTable, 0, 2, "Wins", bgcolor=bgColor, text_color=textColor, text_halign=text.align_left, text_size=btTextSize)
    table.cell(btTable, 1, 2, str.tostring(btWins), bgcolor=bgColor, text_color=color.green, text_halign=text.align_center, text_size=btTextSize)
    table.cell(btTable, 0, 3, "Losses", bgcolor=bgColor, text_color=textColor, text_halign=text.align_left, text_size=btTextSize)
    table.cell(btTable, 1, 3, str.tostring(btLosses), bgcolor=bgColor, text_color=color.red, text_halign=text.align_center, text_size=btTextSize)
    color wrColor = winRate >= 50 ? color.green : color.red
    table.cell(btTable, 0, 4, "Win Rate", bgcolor=bgColor, text_color=textColor, text_halign=text.align_left, text_size=btTextSize)
    table.cell(btTable, 1, 4, str.tostring(winRate, "#.##") + "%", bgcolor=bgColor, text_color=wrColor, text_halign=text.align_center, text_size=btTextSize)
else if not showBacktest and barstate.islast
    table.clear(btTable, 0, 0, 1, 4)

// ============================================================================
// CLEANUP invalidated FVGs from arrays (drawings removed, JSON already sent)
// ============================================================================
cleanupBreakConfirmedFvgs(bullFvgArray1)
cleanupBreakConfirmedFvgs(bearFvgArray1)
cleanupBreakConfirmedFvgs(bullFvgArray2)
cleanupBreakConfirmedFvgs(bearFvgArray2)
