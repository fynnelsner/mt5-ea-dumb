//@version=6
indicator("DevyyTrades Wickless + FVG", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
getPipSize(goldMode, silverMode) =>
    bool isGold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    bool isSilver = str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER")
    float goldVal = goldMode == "Standard ($0.10)" ? 0.1 : 0.01
    float silverVal = silverMode == "Standard ($0.01)" ? 0.01 : 0.001
    isGold ? goldVal : isSilver ? silverVal : (syminfo.mintick * (syminfo.type == "forex" or syminfo.type == "cfd" ? 10 : 1))

getTextSize(sizeStr) =>
    sizeStr == "Tiny" ? size.tiny : sizeStr == "Small" ? size.small : sizeStr == "Large" ? size.large : sizeStr == "Huge" ? size.huge : size.normal

getZoneDuration(sessStr) =>
    string zt = str.substring(sessStr, 0, 9)
    int sH = int(str.tonumber(str.substring(zt, 0, 2)))
    int sM = int(str.tonumber(str.substring(zt, 2, 4)))
    int eH = int(str.tonumber(str.substring(zt, 5, 7)))
    int eM = int(str.tonumber(str.substring(zt, 7, 9)))
    int startMinutes = sH * 60 + sM
    int endMinutes = eH * 60 + eM
    if endMinutes < startMinutes
        endMinutes += 24 * 60
    (endMinutes - startMinutes) * 60000

jsonPrice(v) =>
    na(v) ? "null" : str.tostring(v)

shouldSendWebhook(enableWebhooks) =>
    enableWebhooks and barstate.isconfirmed

htfTF(usrTF) =>
    float chartTFin = timeframe.in_seconds() / 60
    switch
        usrTF == "5 Minutes" and chartTFin <= 5 => "5"
        usrTF == "15 Minutes" and chartTFin <= 15 => "15"
        usrTF == "1 Hour" and chartTFin <= 60 => "60"
        usrTF == "4 Hours" and chartTFin <= 240 => "240"
        usrTF == "1 Day" and timeframe.isintraday => "D"
        usrTF == "1 Week" and (timeframe.isdaily or timeframe.isintraday) => "W"
        usrTF == "1 Month" and (timeframe.isweekly or timeframe.isdaily or timeframe.isintraday) => "M"
        => timeframe.period

trimFvgArray(fvgArray, keepCount) =>
    while fvgArray.size() > keepCount
        old = fvgArray.pop()
        old.lbTxt.delete()
        old.lnTop.delete()
        old.lnAvg.delete()
        old.lnBtm.delete()

buildFvgEntry(fvgObj, tf) =>
    string _state = fvgObj.wasRespected ? "respected" : fvgObj.wasMitigated ? "mitigated" : "active"
    string _mitPx = fvgObj.wasMitigated ? str.tostring(fvgObj.mitPrice) : "null"
    '{"slot":"' + fvgObj.slotId + '","tf":"' + tf + '","direction":"' + fvgObj.direction + '","zone_top":' + str.tostring(fvgObj.zoneTop) + ',"zone_bottom":' + str.tostring(fvgObj.zoneBottom) + ',"zone_mid":' + str.tostring(math.avg(fvgObj.zoneTop,fvgObj.zoneBottom)) + ',"state":"' + _state + '","mit_price":' + _mitPx + '}'

buildFvgJson(entriesArr) =>
    int sz = array.size(entriesArr)
    if sz == 0
        "[]"
    else
        string out = "["
        for i = 0 to sz - 1
            if i > 0
                out := out + ","
            out := out + array.get(entriesArr, i)
        out := out + "]"
        out

collectFvgEntries(fvgArray, tf, entriesArr) =>
    int sz = array.size(fvgArray)
    if sz > 0
        for i = 0 to sz - 1
            fvg = array.get(fvgArray, i)
            if not fvg.breakConfirmed
                array.push(entriesArr, buildFvgEntry(fvg, tf))

isPriceInZone(fvg, isBull) =>
    isBull ? (low <= fvg.zoneTop and high >= fvg.zoneBottom) : (high >= fvg.zoneBottom and low <= fvg.zoneTop)

isPriceRespecting(fvg, isBull) =>
    isBull ? (close > fvg.zoneTop) : (close < fvg.zoneBottom)

updateFvg(fvgArray, fill, side, fvgLb, slotId, tf) =>
    if fvgArray.size() > 0
        for i = array.size(fvgArray) - 1 to 0
            fvg = array.get(fvgArray, i)
            if fvg.breakConfirmed
                continue
            bool inZone = isPriceInZone(fvg, side == "bull")
            bool respecting = isPriceRespecting(fvg, side == "bull")
            if inZone and not fvg.wasMitigated
                fvg.wasMitigated := true
                fvg.mitPrice := close
            if fvg.wasMitigated and respecting and not fvg.wasRespected
                fvg.wasRespected := true
            fvg.lbTxt.set_x(bar_index + 1)
            fvg.lnTop.set_x2(bar_index + 1)
            fvg.lnAvg.set_x2(bar_index + 1)
            fvg.lnBtm.set_x2(bar_index + 1)
            if fill != "None"
                fillRatio = switch side
                    "bull" => (fvg.lnTop.get_y1() - low)  / (fvg.lnTop.get_y1() - fvg.lnBtm.get_y1())
                    "bear" => (high - fvg.lnBtm.get_y1()) / (fvg.lnTop.get_y1() - fvg.lnBtm.get_y1())
                    => 0.0
                if fillRatio > fvg.mit
                    fvg.mit := fillRatio
                    fvg.lbTxt.set_text(fvgLb == "Show" ? fvg.txt + str.format("{0,number,(#.#%)}", fillRatio) : "")
            else
                fvg.lbTxt.set_text(fvgLb == "Show" ? fvg.txt : "")
            array.set(fvgArray, i, fvg)

cleanupBreakConfirmedFvgs(fvgArray) =>
    if fvgArray.size() > 0
        for i = fvgArray.size() - 1 to 0
            fvg = array.get(fvgArray, i)
            if fvg.breakConfirmed
                fvgArray.remove(i)
                fvg.lbTxt.delete()
                fvg.lnTop.delete()
                fvg.lnAvg.delete()
                fvg.lnBtm.delete()

// ============================================================================
// STRUCTURE HISTORY TRACKER (last 5 BOS/ChoCh)
// ============================================================================
buildStructEntry(direction, breakType, breakLevel) =>
    string _dir = direction == 1 ? "bullish" : "bearish"
    '{"direction":"' + _dir + '","break_type":"' + breakType + '","break_level":' + jsonPrice(breakLevel) + ',"bar_time":' + str.tostring(time) + ',"bar_index":' + str.tostring(bar_index) + '}'

buildSwingEntry(swingType, price, barIdx) =>
    '{"type":"' + swingType + '","price":' + jsonPrice(price) + ',"bar_time":' + str.tostring(time) + ',"bar_index":' + str.tostring(barIdx) + '}'

buildStructHistoryJson(histArr) =>
    int sz = array.size(histArr)
    if sz == 0
        "[]"
    else
        string out = "["
        for i = 0 to sz - 1
            if i > 0
                out := out + ","
            out := out + array.get(histArr, i)
        out := out + "]"
        out

buildSwingHistoryJson(histArr) =>
    int sz = array.size(histArr)
    if sz == 0
        "[]"
    else
        string out = "["
        for i = 0 to sz - 1
            if i > 0
                out := out + ","
            out := out + array.get(histArr, i)
        out := out + "]"
        out

// ============================================================================
// TYPES
// ============================================================================
type HTFBar
    float price = na
    int   index = na

type HTFBarOHLC
    HTFBar open
    HTFBar high
    HTFBar low
    HTFBar close

type FVG
    label  lbTxt
    line   lnTop
    line   lnAvg
    line   lnBtm
    float  mitPrice
    float  mit
    string txt
    float  zoneTop
    float  zoneBottom
    string direction
    string slotId
    int    consecutiveBeyond
    float  maxDistanceBeyond
    bool   breakConfirmed
    int    createdBarIndex
    bool   wasMitigated
    bool   wasRespected
    float  lastCloseBeforeMitigation

// ============================================================================
// INPUTS  WICKLESS
// ============================================================================
grpRiskMain  = "Risk Dashboard: Main Settings"
showRiskDash = input.bool(true, title="Risk Dashboard", group=grpRiskMain)
accountCurr  = input.string("USD", title="Account Currency", options=["USD", "EUR", "GBP", "AUD", "CAD", "CHF", "JPY", "NZD"], tooltip="Select your account currency to auto-calculate exact real-time lot sizes.", group=grpRiskMain)
slPips       = input.float(30.6, title="Stop Loss (Pips)", group=grpRiskMain)

grpRiskPct   = "Risk Dashboard: Account Balance & Risk"
accountBal   = input.float(100000, title="Account Balance", group=grpRiskPct)
riskPercent  = input.float(2.0, title="Percentage Risk (%)", step=0.01, group=grpRiskPct)

grpRiskMetals = "Risk Dashboard: Gold & Silver Settings"
goldPipMode  = input.string("Standard ($0.10)", title="Gold Pip Size", options=["Standard ($0.10)", "Micro ($0.01)"], tooltip="Adjust this if your broker calculates Gold pips differently.", group=grpRiskMetals)
silverPipMode = input.string("Standard ($0.01)", title="Silver Pip Size", options=["Standard ($0.01)", "Micro ($0.001)"], tooltip="Adjust this if your broker calculates Silver pips differently.", group=grpRiskMetals)

grpBacktest  = "Win Rate Dashboard"
